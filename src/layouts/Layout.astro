---
import { siteInfo } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sutura Solutions — We build automations for Perth small businesses and train your team to use them. Less admin, more time on what matters.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://www.suturasolutions.com/#website',
      url: siteInfo.url,
      name: siteInfo.name,
      inLanguage: 'en',
      dateModified: siteInfo.lastUpdated,
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.suturasolutions.com/#organization',
      name: siteInfo.name,
      url: siteInfo.url,
      email: siteInfo.email,
      telephone: siteInfo.telephone,
      logo: siteInfo.logo,
      sameAs: siteInfo.sameAs,
      description: siteInfo.description,
      areaServed: {
        '@type': 'City',
        name: siteInfo.areaServed,
      },
      address: {
        '@type': 'PostalAddress',
        ...siteInfo.address,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sutura Solutions" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_AU" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
